<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ai.gateway</groupId>
        <artifactId>ai-capability-gateway</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>gateway-adapter-auth-satoken</artifactId>
    <name>Gateway Adapter Auth Sa-Token</name>
    <description>Pluggable authentication/authorization adapter backed by Sa-Token (JWT mode)</description>

    <dependencies>
        <dependency>
            <groupId>com.ai.gateway</groupId>
            <artifactId>gateway-domain</artifactId>
        </dependency>

        <!-- Sa-Token 核心：与框架无关的认证引擎（不使用 Spring Boot 启动器，
             依据技术选型文档避免自动配置层面的侵入）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
        </dependency>

        <!-- Sa-Token JWT 扩展：无状态的 JWT 创建/解析（基于 hutool-jwt）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
        </dependency>

        <!-- Sa-Token Redisson DAO（Jackson 编解码器）：将会话持久化到
             共享 Redis（技术选型文档 §9 列出 sa-token-dao-redisson，
             其 1.39.0 版本正确的 artifactId 为 sa-token-redisson-jackson）。
             排除传递依赖 redisson-spring-boot-starter：它会引入自动配置，
             无条件连接 Redis，与 SaTokenRedisDaoConfiguration 中编程式的
             Redisson 装配冲突。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redisson-jackson</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 仅用于 @Configuration/@Bean 条件装配的 Spring context。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Sa-Token Redisson DAO（sa-token-redisson-jackson）在运行时内部使用
             Spring Data Redis 的 GenericJackson2JsonRedisSerializer，因此即使我们
             以编程方式装配 Redisson（上面已排除 redisson-spring-boot-starter），
             该依赖也必须存在于 classpath 中。网关不使用 Lettuce（Redis 客户端为
             Redisson），但保留它以满足 Spring Data Redis 自动配置的 classpath 检测；
             没有 spring.data.redis 配置时其连接工厂会自动退出，实际上从不连接。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>


        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
