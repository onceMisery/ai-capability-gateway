# =====================================================================
# Local development overlay — EXAMPLE ONLY, safe to commit.
#
# To use locally, copy this file to application-local.yml and fill in
# real values via environment variables or direct edits.
# application-local.yml is git-ignored and must NEVER be committed
# because it contains real credentials.
#
# Activate with:
#   SPRING_PROFILES_ACTIVE=local
#   mvn -pl gateway-bootstrap spring-boot:run \
#       -Dspring-boot.run.profiles=local
# =====================================================================

server:
  port: 8080
  shutdown: graceful
  max-http-request-header-size: 16KB

spring:
  application:
    name: ai-capability-gateway
  datasource:
    url: ${DB_URL:jdbc:postgresql://127.0.0.1:5432/gateway}
    username: ${DB_USERNAME:gateway}
    password: ${DB_PASSWORD:change-me}
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 5000
      idle-timeout: 300000
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: false
  threads:
    virtual:
      enabled: true

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus

# Gateway configuration
gateway:
  environment: ${GATEWAY_ENV:development}
  max-json-depth: 16
  max-array-length: 1000
  max-object-fields: 1000
  max-string-bytes: 16384
  max-node-count: 10000

  auth:
    provider: ${GATEWAY_AUTH_PROVIDER:sa-token}
    sa-token:
      jwt-secret-key: ${GATEWAY_AUTH_JWT_SECRET:dev-only-insecure-secret-change-me}
    console-admin:
      username: ${GATEWAY_CONSOLE_ADMIN_USERNAME:admin}
      password: ${GATEWAY_CONSOLE_ADMIN_PASSWORD:admin}

  cache:
    provider: ${GATEWAY_CACHE_PROVIDER:redis}

  # Redis (Redisson) connection
  redis:
    address: ${GATEWAY_REDIS_ADDRESS:redis://127.0.0.1:6379}
    password: ${GATEWAY_REDIS_PASSWORD:}
    database: ${GATEWAY_REDIS_DATABASE:0}

  ratelimit:
    provider: ${GATEWAY_RATELIMIT_PROVIDER:stub}

  operation:
    confirmation-secret: ${GATEWAY_CONFIRMATION_SECRET:dev-only-confirmation-secret-32-bytes}

  # LLM configuration
  llm:
    endpoint: ${LLM_ENDPOINT:https://api.deepseek.com/chat/completions}
    api-key: ${LLM_API_KEY:}
    model: ${LLM_MODEL:deepseek-v4-flash}
    temperature: 0.1
    max-tokens: 4096
    max-concurrent: 10

  # Registry configuration
  registries:
    nacos-main:
      address: ${NACOS_ADDRESS:127.0.0.1}
      port: ${NACOS_PORT:8848}

# Dubbo configuration
dubbo:
  registry:
    address: ${DUBBO_REGISTRY:nacos://127.0.0.1:8848}

logging:
  level:
    com.ai.gateway: INFO
